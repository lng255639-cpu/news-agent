# 複製這個檔案成 .env，填入你的設定。
# .env 已在 .gitignore 裡，不會被推上 GitHub。
#
# 最常見的兩種起手式：
#
#   透過中轉站：
#     LLM_PROVIDER=custom
#     LLM_BASE_URL=https://你的中轉站/v1
#     LLM_API_KEY=你的金鑰
#     LLM_MODEL=claude-sonnet-5
#     LLM_TIMEOUT=300
#
#   直連原廠（Groq 有免費額度）：
#     LLM_PROVIDER=groq
#     GROQ_API_KEY=gsk_...
#
# 填完跑 python doctor.py 檢查，再跑 python llm.py 測試連線。
# ============================================================

# 複製成 .env，取消註解你要用的那一組，其他保持註解。
# .env 已在 .gitignore 裡，不會被上傳。

# ============ 直連原廠 ============

LLM_PROVIDER=groq
GROQ_API_KEY=gsk_xxxxxxxxxxxx

# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIzaxxxxxxxxxxxx

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxx

# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx


# ============ 中轉 / 聚合 ============

# --- OpenRouter：一把 key 通吃數百個模型 ---
# 模型名稱是「廠商/模型」格式，跑 `python llm.py models` 看完整清單
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
# LLM_MODEL=anthropic/claude-sonnet-4.5
# 以下兩項選填，填了會出現在 OpenRouter 公開排行榜
# OPENROUTER_SITE_URL=https://你的網站
# OPENROUTER_APP_NAME=News Agent

# --- LiteLLM Proxy：自架，網址和模型別名都是你自己定的 ---
# LLM_PROVIDER=litellm
# LLM_BASE_URL=http://localhost:4000/v1
# LITELLM_API_KEY=sk-你在proxy設的virtual-key
# LLM_MODEL=你在config.yaml定的model_name

# --- 其他任意 OpenAI 相容中轉站 ---
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://中轉站網址/v1
# LLM_API_KEY=你的金鑰
# LLM_MODEL=模型名稱


# ============ 本地 ============

# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:14b
# （不需要 key）


# ============ 通用覆寫（選填）============
# LLM_MODEL=...      覆寫預設模型
# LLM_BASE_URL=...   覆寫 API 網址，任何供應商都適用


# ============ 寄信設定（--email 用）============
# Gmail 必須用「應用程式密碼」，不能用登入密碼。
# 產生方式：Google 帳號 -> 安全性 -> 開啟兩步驟驗證 -> 應用程式密碼
# 產生的 16 碼會顯示成四組，貼進來時要把空格刪掉。

# SMTP_PRESET=gmail
# SMTP_USER=你的帳號@gmail.com
# SMTP_PASS=abcdefghijklmnop
# MAIL_TO=收件人@example.com

# 其他預設值：outlook / yahoo / icloud / zoho
# 或手動指定任意 SMTP 伺服器：
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# MAIL_TO=收件人@example.com
# MAIL_FROM_NAME=News Agent
