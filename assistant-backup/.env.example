# 範本。填好的版本不要 commit（上一層的 .gitignore 已經擋掉 .env）。
# 部署時把這些填進 Render 的 Environment Variables。
#
# ⚠️ 提醒：平台會外洩環境變數（Zeabur 2026-08-27 就發生過）。
#    請維持 Gemini 免費層、不要啟用帳單，這樣金鑰外流也只是額度被用掉，
#    不會有財務損失。詳見指南的「金鑰安全」章節。

# ══ AI 供應商 ═══════════════════════════════════

# 免費，每天約 1500 次。到 https://aistudio.google.com/api-keys 申請
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxx
PROVIDER_ORDER=gemini

# 備援（選填）。填了就把 PROVIDER_ORDER 改成 gemini,groq
# GROQ_API_KEY=gsk_xxxxxxxxxxxx

# 想用 Claude：設下面這行，PROVIDER_ORDER 改成 claude
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# 模型名稱失效時改這裡，不用動程式碼
# GEMINI_MODEL=gemini-2.5-flash

# ══ 網站設定 ════════════════════════════════════

SITE_NAME=每日新聞簡報
AI_NAME=AI小助手
SITE_BASE=https://lng255639-cpu.github.io/news-agent

# ══ ⚠️ 最容易填錯的一行 ═══════════════════════

# GitHub Pages 的 origin 不含路徑！
# 網站在 https://lng255639-cpu.github.io/news-agent/
# 但瀏覽器送出的 Origin 是 https://lng255639-cpu.github.io
# 所以這裡只能填到網域為止，不要加 /news-agent
ALLOWED_ORIGINS=https://lng255639-cpu.github.io

# ══ 流量與快取 ══════════════════════════════════

BRIEF_TTL=900
RATE_PER_MINUTE=5
RATE_PER_HOUR=30
GLOBAL_DAILY_LIMIT=800
MAX_TOKENS=700
